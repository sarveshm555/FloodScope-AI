# ==============================================================================
# FloodScope AI - Environment Configuration Example
# Copy this file to .env and provide your local configurations.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Data Directory Configuration
# IMPORTANT: Raw Sentinel-1 SAFE archives and DEM rasters can exceed several GBs.
# Set FLOODSCOPE_DATA_DIR to a drive with sufficient storage (e.g., D:\FloodScope-Data)
# Default fallback if unset is ./data within the repository.
FLOODSCOPE_DATA_DIR=./data

# Copernicus Data Space Ecosystem (CDSE) Credentials (Optional for catalog search; required for scene downloads)
# Register for free at: https://dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Language Model Providers (Optional for Situation-Report Copilot)
# If neither is configured, FloodScope AI falls back to deterministic rule-based reports.
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
